# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts
.eas-local-build/

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Claude Code (local settings)
.claude/settings.local.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local Android tooling/cache folders kept out of C:\Users paths with accents
/android-sdk/
/.gradle_home/

# copia local del repo web (solo referencia, no parte de la app)
temp_kuanto_web/

# Firebase / FCM — NO commitear
# service account = SECRETO (clave de envío de push); va solo a EAS credentials.
*-firebase-adminsdk-*.json
# config cliente (queda embebida en el APK, pero la ignoramos por precaución;
# para builds en la nube de EAS hay que commitearla o subirla como secret).
google-services.json
GoogleService-Info.plist
