# Copia este archivo a ".env" y rellena los valores.
# Estas variables van embebidas en el bundle del cliente (prefijo EXPO_PUBLIC_).
# La anon key de Supabase es pública por diseño y está protegida por Row Level Security (RLS).

EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY
