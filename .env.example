# Copia este archivo a ".env.local" y rellena los valores del proyecto
# Supabase creado exclusivamente para Kuanto Mobile.
# Estas variables se incrustan en el bundle del cliente (prefijo EXPO_PUBLIC_).
# La publishable key es pública por diseño y está protegida por RLS.
# Nunca coloques aquí una clave sb_secret_ ni service_role.

EXPO_PUBLIC_MOBILE_SUPABASE_URL=https://TU-PROYECTO-MOBILE.supabase.co
EXPO_PUBLIC_MOBILE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR
